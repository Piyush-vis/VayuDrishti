# MongoDB Configuration
# For local Docker setup: mongodb://mongodb:27017
# For local host setup: mongodb://localhost:27017
# For MongoDB Atlas: mongodb+srv://<user>:<pass>@cluster.mongodb.net/vayudrishti
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=vayudrishti

# External APIs (Leave empty to use high-quality simulated data automatically)
OPENWEATHERMAP_API_KEY=
AQICN_API_KEY=
TOMTOM_API_KEY=
NASA_FIRMS_MAP_KEY=
GEMINI_API_KEY=

# Server Configuration
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173
PORT=8000
HOST=0.0.0.0
